// euler.dot — GENERATED by bin/terminology-diagrams; do not hand-edit.
// Set containment from |set-rel subset-of/partitions edges only
// (part-of is mereology and lives in relations.dot, never here).
// LIMITS, honestly: dot nesting cannot draw a true partial overlap —
// `overlaps` pairs render as dashed edges labeled ∩≠∅; sibling clusters
// under a partition are pairwise disjoint by that partition's claim.
// Render: dot -Tsvg euler.dot -o euler.svg
digraph euler {
  compound=true; rankdir=TB; fontname="Helvetica";
  node [fontname="Helvetica", shape=box, style=rounded];
  subgraph "cluster_descriptor" {
    label="descriptor"; fontname="Helvetica"; style=rounded;
    "descriptor" [label="descriptor", shape=plaintext, fontsize=9];
    "description" [label="description", tooltip="A predicate the world satisfies; picks out whatever currently satisfies it — plurality is a feature."];
    subgraph "cluster_designator" {
      label="designator"; fontname="Helvetica"; style=rounded;
      "designator" [label="designator", shape=plaintext, fontsize=9];
      "containment-coordinate" [label="containment\ncoordinate", tooltip="One nesting-container designator inside a location chain."];
      "identity-component" [label="identity\ncomponent", tooltip="A designator for the target itself, as opposed to its containers."];
    }
    subgraph "cluster_location" {
      label="location"; fontname="Helvetica"; style=rounded;
      "location" [label="location", shape=plaintext, fontsize=9];
      "intermediate-location" [label="intermediate\nlocation", tooltip="A step along a path that is itself a location, owning the routing of its next hop."];
      subgraph "cluster_universal-location" {
        label="universal-location"; fontname="Helvetica"; style=rounded;
        "universal-location" [label="universal\nlocation", shape=plaintext, fontsize=9];
        "canonical-location" [label="canonical\nlocation", tooltip="The promise 'this will keep resolving' — breaking it is a breach, not an event."];
        "preferred-location" [label="preferred\nlocation", tooltip="The promise 'this resolves today, and it's the one we'd rather you use' — supersedable without breach."];
      }
    }
  }
  "entity" [label="entity", tooltip="A thing whose identity is independent of its current description; persists through change."];
  "epistemic-bound" [label="epistemic\nbound", tooltip="How many the actor believes exist; divergence is dialogue, not failure — and recorded bounds are free calibration."];
  "expected-cardinality" [label="expected\ncardinality", tooltip="Part of the act's type: how many referents the actor means to pick out; gives a miss its meaning."];
  "naming-community" [label="naming\ncommunity", tooltip="Whoever maintains a designator's binding: a family, a filesystem, a registry, a store."];
  "operational-bound" [label="operational\nbound", tooltip="How many the act will touch; divergence is failure."];
  "over-determination" [label="over\ndetermination", tooltip="Descriptors past the minimum are verification and redundant routes, not redundancy."];
  subgraph "cluster_path" {
    label="path"; fontname="Helvetica"; style=rounded;
    "path" [label="path", shape=plaintext, fontsize=9];
    "working-path" [label="working\npath", tooltip="No promise at all: whatever route works from here, now; expected to expire with its context."];
  }
  "perspective" [label="perspective", tooltip="What an engine resolves relative to: an origin, a scope, a moment, a policy about what counts as the world."];
  "progressive-routing" [label="progressive\nrouting", tooltip="Per-hop ownership of resolution; quietly generates most of the machinery."];
  "reference-act" [label="reference\nact", tooltip="The root act: descriptors supplied to narrow the world to an intended referent."];
  "referent" [label="referent", tooltip="The thing an act intends to pick out."];
  "resolution-engine" [label="resolution\nengine", tooltip="What performs resolution, relative to a perspective; owes the actor six obligations."];
  "sequence-cause" [label="sequence\ncause", tooltip="Why order appears in an address at all: three causes, per-segment, and exactly what an engine may optimize."];
  "true-identity" [label="true\nidentity", tooltip="The promise 'this names IT' — held by the minting community, independent of routability."];
  "value-object" [label="value\nobject", tooltip="A thing that IS its description; cannot dangle, rename, or change."];
  "identity-component" -> "location" [dir=none, style=dashed, label="∩ ≠ ∅", fontsize=9, constraint=false];
  "entity" -> "value-object" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, constraint=false];
  "canonical-location" -> "true-identity" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, constraint=false];
  "preferred-location" -> "true-identity" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, constraint=false];
  "true-identity" -> "working-path" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, constraint=false];
}
