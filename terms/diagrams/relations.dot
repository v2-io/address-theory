// relations.dot — GENERATED by bin/terminology-diagrams; do not hand-edit.
// Typed edges parsed from |invariants controlled phrasings; arities {n,m}.
// Render: dot -Tsvg relations.dot
digraph relations {
  rankdir=LR; fontname="Helvetica";
  node [fontname="Helvetica", shape=box, style=rounded];
  // omitted (no relations; see euler.dot): true-identity
  "canonical-location" [tooltip="The promise 'this will keep resolving' — breaking it is a breach, not an event."];
  "containment-coordinate" [tooltip="The name of one nesting container inside a location chain."];
  "description" [tooltip="A predicate the world satisfies — nothing was ever bound; the connection is recomputed from whatever satisfies it at each use."];
  "descriptor" [tooltip="One narrowing supplied by a reference-act — connected to its referent by an agreement or by a fact, and nothing else."];
  "designator" [tooltip="A minted name bound to its referent by convention — the binding, not the referent's properties, is the whole connection."];
  "destination" [tooltip="The location a path routes to."];
  "entity" [tooltip="A thing whose identity is independent of its current description — it persists through change."];
  "epistemic-bound" [tooltip="How many the actor believes exist — 'no more than three, or I've grossly misunderstood the data.'"];
  "expected-cardinality" [tooltip="How many referents the actor means to pick out — part of the act's type, knowable before resolution, and what gives a miss its meaning."];
  "identity-component" [tooltip="A designator for the target itself, as opposed to its containers."];
  "intermediate-location" [tooltip="A non-terminal step of a path that is itself a location."];
  "location" [tooltip="A containment claim over a designated container — 'contained in c', where c is named by a containment-coordinate."];
  "naming-community" [tooltip="Whoever maintains a designator's binding — a family, a filesystem, a store."];
  "operational-bound" [tooltip="How many the act will touch — 'change the first,' 'take them all.'"];
  "origin" [tooltip="The location a path routes from."];
  "over-determination" [tooltip="Descriptors past the minimum needed to reach one referent — they are verification and redundant routes, never waste."];
  "path" [tooltip="One set of monotonic steps between two locations."];
  "perspective" [tooltip="What an engine resolves relative to: an origin, a scope, a moment, a policy about what counts as the world."];
  "preferred-location" [tooltip="The promise 'this resolves today, and it's the one we'd rather you use.'"];
  "progressive-routing" [tooltip="Per-hop ownership of resolution: each intermediate location routes only its next hop."];
  "reference-act" [tooltip="'The address you gave us is ambiguous and there are several people by that name it might end up with.' — the refused package that opens the postal model"];
  "referent" [tooltip="The thing a reference-act intends to pick out."];
  "resolution-engine" [tooltip="What performs resolution — never a property of the act itself."];
  "sequence-cause" [tooltip="Why order appears in an address at all — and exactly what an engine may optimize."];
  "universal-path" [tooltip="A path routable to its destination from any origin (within a bounded context)."];
  "value-object" [tooltip="A thing that IS its description — 'which one' is a meaningless question."];
  "working-path" [tooltip="No promise at all: whatever route works from here, now — expected to expire with its context."];
  "containment-coordinate" -> "location" [label="belongs-to {1,1}", fontsize=9];
  "description" -> "referent" [label="picks-out {0,N}", fontsize=9];
  "designator" -> "naming-community" [label="held-by {1,1}", fontsize=9];
  "destination" -> "path" [label="belongs-to {1,1}", fontsize=9];
  "destination" -> "location" [label="filled-by {1,1}", fontsize=9];
  "entity" -> "designator" [label="identified-by {1,N}", fontsize=9];
  "epistemic-bound" -> "expected-cardinality" [label="belongs-to {1,1}", fontsize=9];
  "expected-cardinality" -> "reference-act" [label="belongs-to {1,1}", fontsize=9];
  "expected-cardinality" -> "operational-bound" [label="has {1,1}", fontsize=9];
  "expected-cardinality" -> "epistemic-bound" [label="has {0,1}", fontsize=9];
  "intermediate-location" -> "path" [label="is-a-nonterminal-step-of {1,N}", fontsize=9];
  "location" -> "containment-coordinate" [label="names-its-container-via {1,N}", fontsize=9];
  "naming-community" -> "designator" [label="maintains {0,N}", fontsize=9];
  "operational-bound" -> "expected-cardinality" [label="belongs-to {1,1}", fontsize=9];
  "origin" -> "path" [label="belongs-to {1,1}", fontsize=9];
  "origin" -> "location" [label="filled-by {1,1}", fontsize=9];
  "over-determination" -> "referent" [label="verifies {1,N}", fontsize=9];
  "path" -> "origin" [label="has {1,1}", fontsize=9];
  "path" -> "destination" [label="has {1,1}", fontsize=9];
  "path" -> "sequence-cause" [label="steps-each-carry {1,1}", fontsize=9];
  "perspective" -> "resolution-engine" [label="parameterizes {1,N}", fontsize=9];
  "progressive-routing" -> "resolution-engine" [label="performed-by {1,1}", fontsize=9];
  "reference-act" -> "descriptor" [label="has {1,N}", fontsize=9];
  "reference-act" -> "expected-cardinality" [label="carries {1,1}", fontsize=9];
  "reference-act" -> "referent" [label="targets {1,N}", fontsize=9];
  "referent" -> "reference-act" [label="targeted-by {1,N}", fontsize=9];
  "resolution-engine" -> "reference-act" [label="resolves {0,N}", fontsize=9];
  "resolution-engine" -> "perspective" [label="relative-to {1,1}", fontsize=9];
  "sequence-cause" -> "path" [label="belongs-to {1,1}", fontsize=9];
  "description" -> "designator" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "destination" -> "origin" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "entity" -> "value-object" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "epistemic-bound" -> "operational-bound" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "containment-coordinate" -> "designator" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "identity-component" -> "designator" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "description" -> "descriptor" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "designator" -> "descriptor" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "intermediate-location" -> "location" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "location" -> "description" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "universal-path" -> "path" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "working-path" -> "path" [label="is-a", fontsize=9, color="#999999", fontcolor="#999999", arrowhead=onormal];
  "canonical-location" -> "universal-path" [label="is-a? pending (d11-universal-path)", fontsize=9, style=dashed, color="#bb8800", fontcolor="#bb8800", arrowhead=onormal];
  "preferred-location" -> "universal-path" [label="is-a? pending (d11-universal-path)", fontsize=9, style=dashed, color="#bb8800", fontcolor="#bb8800", arrowhead=onormal];
}
