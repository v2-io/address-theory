#!/usr/bin/env ruby
# compose-defs — the whole-picture overview of the foundation definitions.
#
# Concatenates each def/ file's *leading prose* (everything before its first
# |term[ line), in outline order, as markdown — so the term-groups' narrative
# intros read as one continuous pass. Relies on the convention that every
# group's terms are all discussed in its leading prose.
#
# Term map: derived each run from the live def/ files (no hardcoded list).
# Each |term declares its own forms (:pos noun/verb, :pl …; see
# bin/lib/def_terms.rb), so @{referent}/@{referents} or @{resolve}/@{resolved}
# reach the same def file; a form no term declares is left as written and
# reported on stderr. The written surface is what appears in the link text.
#
# Surface forms in the overview:
#   @{term}        → *[[def-….ud|term]]*   when the term lives in another def file
#                  → ==*term*==            when it is defined in this same file/group
#                                          (Obsidian highlight + emphasis)
#   **TERM**       → '**[[def-….ud|TERM]]**'   (single-quoted; always linked;
#                    display keeps the CAPS — definitional spotlight)
# For @{…}, display is the written surface, title-cased only at sentence start.
#
# Usage:
#   bin/compose-defs              write LEXICON-overview.md at instance root
#   bin/compose-defs -o PATH      write PATH
#   bin/compose-defs -            write stdout

require "dry/inflector"
require_relative "lib/def_terms"

root        = File.expand_path("..", __dir__)
outline     = File.join(root, "ADDRESSING-THEORY.outline.md")
default_out = File.join(root, "LEXICON-overview.md")
inflector   = Dry::Inflector.new

abort "no outline at #{outline}" unless File.exist?(outline)

slugs = DefTerms.outline_slugs(outline)
abort "no [[def-*.ud]] links found in outline" if slugs.empty?

# ── helpers ──────────────────────────────────────────────────────────
#
# The term-linking conventions live in bin/lib/def_terms.rb (required at the
# top), shared with bin/compose-lexicon (LEXICON.md) so the two views link
# terms identically.

include DefTerms

# ── term map: from each |term's declared forms (:pos / :pl …) ────────
#
# Built before any prose is rewritten, so a term defined later in reading
# order still links. A term with no :pos falls back to dry-inflector guesses
# (and says so on stderr); so does an id named only in a group header.

decls = []
header_only = []
slugs.each do |slug|
  path = File.join(root, "def", "#{slug}.ud")
  next unless File.exist?(path)
  file_decls = DefTerms.scan_decls(path, "#{slug}.ud")
  decls.concat(file_decls)
  File.foreach(path) do |line|
    next unless line =~ /^\s*\|term-group((?:\[[^\]]+\])+)/
    line.scan(/\[([^\]]+)\]/).flatten.map(&:strip).each do |id|
      next if file_decls.any? { |d| ([d.id] + d.aliases).include?(id) }
      header_only << DefTerms::Decl.new(id: id, aliases: [], file: "#{slug}.ud", line: nil, pos: [], forms: {})
    end
  end
end
map_notes = []
term_map, term_info = DefTerms.build_term_map(decls, header_only, inflector, map_notes)
map_notes.each { |n| warn "compose-defs: #{n[:file]}#{n[:line] ? ":#{n[:line]}" : ''}: #{n[:msg].delete('`')}" }

# ── extract ──────────────────────────────────────────────────────────

sections = []

slugs.each do |slug|
  path = File.join(root, "def", "#{slug}.ud")
  unless File.exist?(path)
    sections << { slug: slug, missing: true }
    next
  end

  head = []
  File.foreach(path) do |line|
    break if line =~ /^\s*\|term\[/
    head << line
  end

  primary = nil
  status  = nil
  prose   = []
  terms   = []
  def_file = "#{slug}.ud"

  head.each do |line|
    if line =~ /^\s*\|term-group((?:\[[^\]]+\])+)/
      terms = line.scan(/\[([^\]]+)\]/).flatten
      primary = terms.first
      next
    end
    if (m = line.match(/^\s*:status\s+(\S+)/))
      status = m[1]
      next
    end
    prose << line
  end

  # Drop blank lines, dedent common indent (the .ud sources indent under
  # term-group), then treat each remaining source line as its own markdown
  # paragraph — the def/ convention is one long line per paragraph, with
  # adjacent lines meaning a new paragraph, not a soft wrap.
  prose = prose.reject { |l| l.strip.empty? }
  if prose.any?
    min_indent = prose.map { |l| l[/^\s*/].size }.min
    prose = prose.map { |l| l.sub(/^[ \t]{0,#{min_indent}}/, "").rstrip }
  end

  title = title_case_term(primary || slug.sub(/\Adef-/, ""))

  # Subtitle roster: each term's base form (its id), title-cased, middle-dot
  # joined; intended-cardinality → Intended-Cardinality. A term with no :pos
  # (no declared base) is singularized, as before :pos existed.
  term_roster = terms.map { |t|
    declared = decls.any? { |d| d.id == t && d.pos.any? }
    title_case_term(declared ? t : inflector.singularize(t))
  }.uniq

  sections << {
    slug:        slug,
    primary:     primary,
    status:      status,
    title:       title,
    term_roster: term_roster,
    prose:       prose, # Array of paragraphs; rewritten after full map is built
  }
end

# ── rewrite + render ─────────────────────────────────────────────────

unmapped = []
undeclared_suffix = [] # **TERM**x where TERMx is no declared form

md = +""
md << <<~HEADER
  <!-- GENERATED VIEW — do not edit by hand; regenerate with `bin/compose-defs`

  The foundation term-groups' narrative intros, in outline (dependency) order —
  one continuous reading pass over what the formal |term[ entries then pin down.
  Source: leading prose of each def/*.ud linked from ADDRESSING-THEORY.outline.md.
  Term links derived each run from the live def/ files; each term's forms come
  from its own :pos / :pl declarations.
  -->

HEADER

md << "# LEXICON overview\n\n"

sections.each do |s|
  if s[:missing]
    md << "## #{s[:slug]}\n\n"
    md << "> **Missing:** `#{s[:slug]}.ud` is linked from the outline but not " \
          "present under `def/`.\n\n"
    next
  end

  home_def = "#{s[:slug]}.ud"
  rewritten = s[:prose].map { |para|
    rewrite_terms(para, term_map, home_def, unmapped,
                  on_ref: ->(surface, _df, kind) { undeclared_suffix << surface if kind == :bold_suffix })
  }
  md << "## #{s[:title]}\n"
  unless s[:term_roster].empty?
    md << "*(  " << s[:term_roster].join("  ·  ") << "  )*\n"
  end
  md << "\n"
  md << rewritten.join("\n\n") << "\n\n"
end

unless unmapped.empty?
  warn "compose-defs: unmapped term surface(s) left as-is:"
  unmapped.uniq.each { |t| warn "  #{t}" }
end
unless undeclared_suffix.empty?
  warn "compose-defs: bold term + letters that make no declared form (the term linked, the letters left after it):"
  undeclared_suffix.uniq.each { |t| warn "  #{t}" }
end

# ── write ────────────────────────────────────────────────────────────

out_path =
  if (i = ARGV.index("-o"))
    ARGV[i + 1] or abort "compose-defs: -o requires a path"
  elsif ARGV.include?("-")
    nil # stdout
  else
    default_out
  end

if out_path
  File.write(out_path, md)
  warn "wrote #{out_path}"
else
  print md
end
