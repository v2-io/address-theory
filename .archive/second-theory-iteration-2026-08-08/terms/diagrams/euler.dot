// euler.dot — GENERATED by bin/terminology-diagrams; do not hand-edit.
// Containment parsed from |invariants "Is a kind of"/"Every … exactly one of".
// Pending relations are dashed amber and non-structural; cross-cluster
// disjoints live in the legend note. Render: dot -Tsvg euler.dot
digraph euler {
  compound=true; rankdir=TB; fontname="Helvetica";
  node [fontname="Helvetica", shape=box, style=rounded];
  "canonical-location" [label="canonical\nlocation", tooltip="The promise 'this will keep resolving' — breaking it is a breach, not an event."];
  subgraph "cluster_descriptor" {
    label="descriptor"; fontname="Helvetica"; style=rounded;
    "descriptor" [shape=point, style=invis, label="", width=0.01, height=0.01, fixedsize=true];
    subgraph "cluster_description" {
      label="description"; fontname="Helvetica"; style=rounded;
      "description" [shape=point, style=invis, label="", width=0.01, height=0.01, fixedsize=true];
      subgraph "cluster_location" {
        label="location"; fontname="Helvetica"; style=rounded;
        "location" [shape=point, style=invis, label="", width=0.01, height=0.01, fixedsize=true];
        "intermediate-location" [label="intermediate\nlocation", tooltip="A non-terminal step of a path that is itself a location."];
      }
    }
    subgraph "cluster_designator" {
      label="designator"; fontname="Helvetica"; style=rounded;
      "designator" [shape=point, style=invis, label="", width=0.01, height=0.01, fixedsize=true];
      "containment-coordinate" [label="containment\ncoordinate", tooltip="The name of one nesting container inside a location chain."];
      "identity-component" [label="identity\ncomponent", tooltip="A designator for the target itself, as opposed to its containers."];
    }
  }
  "destination" [label="destination", tooltip="The location a path routes to."];
  "entity" [label="entity", tooltip="A thing whose identity is independent of its current description — it persists through change."];
  "epistemic-bound" [label="epistemic\nbound", tooltip="How many the actor believes exist — 'no more than three, or I've grossly misunderstood the data.'"];
  "expected-cardinality" [label="expected\ncardinality", tooltip="How many referents the actor means to pick out — part of the act's type, knowable before resolution, and what gives a miss its meaning."];
  "naming-community" [label="naming\ncommunity", tooltip="Whoever maintains a designator's binding — a family, a filesystem, a store."];
  "operational-bound" [label="operational\nbound", tooltip="How many the act will touch — 'change the first,' 'take them all.'"];
  "origin" [label="origin", tooltip="The location a path routes from."];
  "over-determination" [label="over\ndetermination", tooltip="Descriptors past the minimum needed to reach one referent — they are verification and redundant routes, never waste."];
  subgraph "cluster_path" {
    label="path"; fontname="Helvetica"; style=rounded;
    "path" [shape=point, style=invis, label="", width=0.01, height=0.01, fixedsize=true];
    "universal-path" [label="universal\npath", tooltip="A path routable to its destination from any origin (within a bounded context)."];
    "working-path" [label="working\npath", tooltip="No promise at all: whatever route works from here, now — expected to expire with its context."];
  }
  "perspective" [label="perspective", tooltip="What an engine resolves relative to: an origin, a scope, a moment, a policy about what counts as the world."];
  "preferred-location" [label="preferred\nlocation", tooltip="The promise 'this resolves today, and it's the one we'd rather you use.'"];
  "progressive-routing" [label="progressive\nrouting", tooltip="Per-hop ownership of resolution: each intermediate location routes only its next hop."];
  "reference-act" [label="reference\nact", tooltip="'The address you gave us is ambiguous and there are several people by that name it might end up with.' — the refused package that opens the postal model"];
  "referent" [label="referent", tooltip="The thing a reference-act intends to pick out."];
  "resolution-engine" [label="resolution\nengine", tooltip="What performs resolution — never a property of the act itself."];
  "sequence-cause" [label="sequence\ncause", tooltip="Why order appears in an address at all — and exactly what an engine may optimize."];
  "true-identity" [label="true\nidentity", tooltip="The promise 'this names IT' — held by the minting community, independent of routability."];
  "value-object" [label="value\nobject", tooltip="A thing that IS its description — 'which one' is a meaningless question."];
  "canonical-location" -> "true-identity" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, decorate=true, color="#333333", fontcolor="#333333", constraint=false];
  "preferred-location" -> "true-identity" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, decorate=true, color="#333333", fontcolor="#333333", constraint=false];
  "canonical-location" -> "preferred-location" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, decorate=true, color="#333333", fontcolor="#333333", constraint=false];
  "entity" -> "value-object" [dir=none, style=dotted, label="∩ = ∅", fontsize=9, decorate=true, color="#333333", fontcolor="#333333", constraint=false];
  "canonical-location" -> "universal-path" [dir=none, style=dashed, label="is-a? pending (d11-universal-path)", fontsize=9, decorate=true, color="#bb8800", fontcolor="#bb8800"];
  "preferred-location" -> "universal-path" [dir=none, style=dashed, label="is-a? pending (d11-universal-path)", fontsize=9, decorate=true, color="#bb8800", fontcolor="#bb8800"];
  "__disjoint_legend" [shape=note, fontsize=9, label="disjoint (cross-cluster):\ltrue-identity ∩ working-path = ∅\lcanonical-location ∩ working-path = ∅\lpreferred-location ∩ working-path = ∅\l"];
}
