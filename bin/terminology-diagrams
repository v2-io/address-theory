#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/terminology-diagrams — derive diagrams from terms/*.term.un.
#
# The entries carry structure as PROSE: |invariants bullets in the controlled
# phrasings listed in terms/TERM.term.un ("Is a kind of …", "Belongs to …",
# "Has one or more …", …). This script parses exactly those phrasings; free
# prose is kept in entries but not graphed. (Re-cut 2026-08-08 with the
# episode-spine entry shape; the earlier |set-rel/|rel machinery is gone.)
#
# OUTPUTS (terms/diagrams/, GENERATED): euler.dot (containment from is-a +
# partitions; disjoints local-or-legend; pending = dashed amber, non-structural),
# relations.dot + relations.mmd (typed edges with {n,m} arities, duals bold).
# Render: dot -Tsvg <file>. --check regenerates in memory, exit 1 if stale.
#
# Line-based harvester, NOT a conformant udon parser; deleted when one lands.

require "optparse"
require "pathname"

opts = { check: false, root: nil }
OptionParser.new do |o|
  o.on("--check") { opts[:check] = true }
  o.on("--root DIR") { |v| opts[:root] = v }
  o.on("-h", "--help") { puts o; exit 0 }
end.parse!(ARGV)

root = Pathname.new(opts[:root] || Dir.pwd).expand_path
root = root.parent while !root.join("terms").directory? && root != root.parent
abort "terminology-diagrams: no terms/ dir found" unless root.join("terms").directory?
terms_dir = root.join("terms")

ARITY = {
  "exactly one" => "{1,1}", "at most one" => "{0,1}",
  "one or more" => "{1,N}", "zero or more" => "{0,N}", "any number of" => "{0,N}"
}.freeze
TERMLINK = %r{\[\[term/([a-z0-9-]+)(?:\|[^\]]*)?\]\]}
PENDING  = %r{\A\(pending \[\[DECISIONS#([a-z0-9-]+)\|[^\]]*\]\]\)\s*}

Term = Struct.new(:slug, :gloss, :is_a, :partition, :duals, :disjoint_groups,
                  :never, :edges, :overlaps, keyword_init: true)

def parse_term(path)
  slug = nil
  gloss = ""
  in_inv = false
  t = Term.new(is_a: [], partition: [], duals: [], disjoint_groups: [], never: [], edges: [], overlaps: [])
  path.read.each_line do |raw|
    s = raw.rstrip
    next if s.strip.start_with?(";")
    if (m = s.match(/\A\|term\[([a-z0-9-]+)\]/))
      slug = m[1]
      next
    end
    if s =~ /\A\s+\|invariants\b/
      in_inv = true
      next
    elsif s =~ /\A\s+\|/
      in_inv = false
      next
    end
    next if s =~ /\A\s+:/ # attributes
    if !in_inv && gloss.empty? && s =~ /\A\s+\S/ && slug
      gloss = s.strip.gsub(TERMLINK) { Regexp.last_match(1) }
      next
    end
    next unless in_inv && (m = s.match(/\A\s+-\s+(.*)\z/))
    line = m[1]
    pend = nil
    if (pm = line.match(PENDING))
      pend = pm[1]
      line = line.sub(PENDING, "")
    end
    links = line.scan(TERMLINK).flatten
    case line
    when /\AEvery .+ is exactly one of /
      t.partition = links
    when /mutually exclusive:/i
      t.disjoint_groups << links
    when /\AIs a kind of /
      t.is_a << { to: links.first, pending: pend } if links.first
    when /\AIs the dual of /
      t.duals << links.first if links.first
    when /\ANever an? /
      t.never << links.first if links.first
    when /\AMay share members with /
      t.overlaps << links.first if links.first
    when /\ABelongs to /
      t.edges << { verb: "belongs-to", to: links.first, arity: "{1,1}", pending: pend } if links.first
    when /\A(.+?)\s+(#{ARITY.keys.join('|')})\s+\[\[term\//
      vm = line.match(/\A(.+?)\s+(#{ARITY.keys.join('|')})\s+\[\[term\/([a-z0-9-]+)/)
      verb = vm[1].sub(/\AHas\z/, "has").downcase.gsub(/[^a-z ]/, "").strip.tr(" ", "-")
      verb = "has" if verb.empty?
      t.edges << { verb: verb, to: vm[3], arity: ARITY[vm[2]], pending: pend }
    end
  end
  return nil unless slug
  t.slug = slug
  t.gloss = gloss
  t
end

terms = terms_dir.glob("*.term.un").reject { |p| p.basename.to_s == "TERM.term.un" }
                 .sort.filter_map { |p| parse_term(p) }
by_slug = terms.to_h { |t| [t.slug, t] }

# ── containment forest (is-a + partitions); pending is non-structural ────────
children = Hash.new { |h, k| h[k] = [] }
pending_rels = []
terms.each do |t|
  t.is_a.each do |r|
    if r[:pending]
      pending_rels << { from: t.slug, to: r[:to], cite: r[:pending] }
    else
      children[r[:to]] << t.slug
    end
  end
  t.partition.each { |c| children[t.slug] << c unless children[t.slug].include?(c) }
end
children.each_value(&:uniq!)

disjoints = []
terms.each do |t|
  t.never.each { |o| disjoints << [t.slug, o].sort }
  t.disjoint_groups.each { |g| g.combination(2).each { |a, b| disjoints << [a, b].sort } }
end
disjoints.uniq!
overlaps = terms.flat_map { |t| t.overlaps.map { |o| [t.slug, o].sort } }.uniq

all_contained = children.values.flatten.uniq
roots = (children.keys - all_contained) + (terms.map(&:slug) - children.keys - all_contained)

def dot_label(slug) = slug.gsub("-", '\n')

def emit_cluster(out, slug, children, by_slug, depth, seen)
  ind = "  " * depth
  if seen.include?(slug)
    out << "#{ind}// CYCLE at #{slug} — an is-a cycle is equals-in-disguise; fix the data\n"
    return
  end
  seen += [slug]
  kids = children[slug]
  if kids.empty?
    tip = by_slug[slug]&.gloss.to_s.gsub('"', "'")
    out << "#{ind}\"#{slug}\" [label=\"#{dot_label(slug)}\", tooltip=\"#{tip}\"];\n"
  else
    out << "#{ind}subgraph \"cluster_#{slug}\" {\n"
    out << "#{ind}  label=\"#{slug}\"; fontname=\"Helvetica\"; style=rounded;\n"
    out << "#{ind}  \"#{slug}\" [shape=point, style=invis, label=\"\", width=0.01, height=0.01, fixedsize=true];\n"
    kids.sort.each { |k| emit_cluster(out, k, children, by_slug, depth + 1, seen) }
    out << "#{ind}}\n"
  end
end

euler = +""
euler << "// euler.dot — GENERATED by bin/terminology-diagrams; do not hand-edit.\n"
euler << "// Containment parsed from |invariants \"Is a kind of\"/\"Every … exactly one of\".\n"
euler << "// Pending relations are dashed amber and non-structural; cross-cluster\n"
euler << "// disjoints live in the legend note. Render: dot -Tsvg euler.dot\n"
euler << "digraph euler {\n  compound=true; rankdir=TB; fontname=\"Helvetica\";\n"
euler << "  node [fontname=\"Helvetica\", shape=box, style=rounded];\n"
roots.sort.each { |r| emit_cluster(euler, r, children, by_slug, 1, []) }

annot = lambda do |a, b, style, lbl, color, constrain|
  attrs = ["dir=none", "style=#{style}", "label=\"#{lbl}\"", "fontsize=9", "decorate=true",
           "color=\"#{color}\"", "fontcolor=\"#{color}\""]
  attrs << "constraint=false" unless constrain
  attrs << "ltail=\"cluster_#{a}\"" if children[a].any?
  attrs << "lhead=\"cluster_#{b}\"" if children[b].any?
  "  \"#{a}\" -> \"#{b}\" [#{attrs.join(', ')}];\n"
end

overlaps.each { |a, b| euler << annot.call(a, b, "dashed", "∩ ≠ ∅", "#333333", false) }
parent_of = {}
children.each { |par, kids| kids.each { |k| parent_of[k] = par } }
drawn, listed = disjoints.reject { |a, b| children.any? { |_, kids| kids.include?(a) && kids.include?(b) } }
                         .partition { |a, b| parent_of[a] == parent_of[b] }
drawn.each { |a, b| euler << annot.call(a, b, "dotted", "∩ = ∅", "#333333", false) }
pending_rels.each { |pr| euler << annot.call(pr[:from], pr[:to], "dashed", "is-a? pending (#{pr[:cite]})", "#bb8800", true) }
unless listed.empty?
  rows = listed.map { |a, b| "#{a} ∩ #{b} = ∅" }.join("\\l")
  euler << "  \"__disjoint_legend\" [shape=note, fontsize=9, label=\"disjoint (cross-cluster):\\l#{rows}\\l\"];\n"
end
euler << "}\n"

# ── relation views ───────────────────────────────────────────────────────────
set_edges = children.flat_map { |sup, kids| kids.map { |k| [k, sup] } }
duals_pairs = terms.flat_map { |t| t.duals.map { |d| [t.slug, d].sort } }.uniq
connected = (terms.flat_map { |t| t.edges.map { |e| [t.slug, e[:to]] } }.flatten +
             set_edges.flatten + duals_pairs.flatten +
             pending_rels.flat_map { |pr| [pr[:from], pr[:to]] }).uniq
omitted = terms.map(&:slug) - connected

rel = +""
rel << "// relations.dot — GENERATED by bin/terminology-diagrams; do not hand-edit.\n"
rel << "// Typed edges parsed from |invariants controlled phrasings; arities {n,m}.\n"
rel << "// Render: dot -Tsvg relations.dot\n"
rel << "digraph relations {\n  rankdir=LR; fontname=\"Helvetica\";\n"
rel << "  node [fontname=\"Helvetica\", shape=box, style=rounded];\n"
rel << "  // omitted (no relations; see euler.dot): #{omitted.sort.join(', ')}\n" unless omitted.empty?
terms.select { |t| connected.include?(t.slug) }.each do |t|
  rel << "  \"#{t.slug}\" [tooltip=\"#{t.gloss.gsub('"', "'")}\"];\n"
end
terms.each do |t|
  t.edges.each do |e|
    style = e[:pending] ? ", style=dashed, color=\"#bb8800\", fontcolor=\"#bb8800\"" : ""
    lbl = "#{e[:verb]} #{e[:arity]}#{e[:pending] ? " pending (#{e[:pending]})" : ''}"
    rel << "  \"#{t.slug}\" -> \"#{e[:to]}\" [label=\"#{lbl}\", fontsize=9#{style}];\n"
  end
end
duals_pairs.each { |a, b| rel << "  \"#{a}\" -> \"#{b}\" [dir=both, style=bold, label=\"dual\", fontsize=9, color=\"#666666\"];\n" }
set_edges.each { |sub, sup| rel << "  \"#{sub}\" -> \"#{sup}\" [label=\"is-a\", fontsize=9, color=\"#999999\", fontcolor=\"#999999\", arrowhead=onormal];\n" }
pending_rels.each { |pr| rel << "  \"#{pr[:from]}\" -> \"#{pr[:to]}\" [label=\"is-a? pending (#{pr[:cite]})\", fontsize=9, style=dashed, color=\"#bb8800\", fontcolor=\"#bb8800\", arrowhead=onormal];\n" }
rel << "}\n"

mmd = +""
mmd << "%% relations.mmd — GENERATED by bin/terminology-diagrams; do not hand-edit.\n"
mmd << "%% omitted (no relations; see euler.dot): #{omitted.sort.join(', ')}\n" unless omitted.empty?
mmd << "flowchart LR\n"
n = ->(s) { s.tr("-", "_") }
terms.select { |t| connected.include?(t.slug) }.each { |t| mmd << "  #{n.(t.slug)}[\"#{t.slug}\"]\n" }
terms.each do |t|
  t.edges.each { |e| mmd << "  #{n.(t.slug)} -->|#{e[:verb]} #{e[:arity]}#{e[:pending] ? " pending #{e[:pending]}" : ''}| #{n.(e[:to])}\n" }
end
set_edges.each { |sub, sup| mmd << "  #{n.(sub)} -.->|is-a| #{n.(sup)}\n" }
pending_rels.each { |pr| mmd << "  #{n.(pr[:from])} -.->|is-a? pending #{pr[:cite]}| #{n.(pr[:to])}\n" }
duals_pairs.each { |a, b| mmd << "  #{n.(a)} <-->|dual| #{n.(b)}\n" }

# ── unified view (steward request 2026-08-08): the euler chunks ARE the ERD's
# elements — containment is shown by nesting ONLY (no is-a edges anywhere), so
# every drawn edge is a genuine relation, and an edge may attach to a container's
# border (d2 compound edges) — "allowing edges from anything else to attach to
# the correct outer/inner edge of the thing they apply to." Dangling terms float
# uncontained, deliberately: that tail is the steward's uncontainment worklist.
# Disjoints stay in euler.dot; duals bold; pending dashed amber, non-structural.
parent_of ||= {}
fullpath = {}
resolve_fp = nil
resolve_fp = ->(s) { fullpath[s] ||= parent_of[s] ? "#{resolve_fp.call(parent_of[s])}.#{s}" : s }
terms.each { |t| resolve_fp.call(t.slug) }

d2 = +""
d2 << "# unified.d2 — GENERATED by bin/terminology-diagrams; do not hand-edit.\n"
d2 << "# Containment = nesting (never edges); every edge is a relation; edges may\n"
d2 << "# terminate at container borders. Render: d2 --layout=elk unified.d2 out.svg\n"
emit_d2 = nil
emit_d2 = lambda do |slug, depth|
  ind = "  " * depth
  gloss = by_slug[slug]&.gloss.to_s.gsub('"', "'").tr("\n", " ")
  d2 << "#{ind}#{slug}: {\n"
  d2 << "#{ind}  tooltip: \"#{gloss}\"\n" unless gloss.empty?
  children[slug].sort.each { |k| emit_d2.call(k, depth + 1) }
  d2 << "#{ind}}\n"
end
roots.sort.each { |r| emit_d2.call(r, 0) }
terms.each do |t|
  t.edges.each do |e|
    from = fullpath[t.slug] || t.slug
    to = fullpath[e[:to]] || e[:to]
    if e[:pending]
      d2 << "#{from} -> #{to}: \"#{e[:verb]} #{e[:arity]} pending (#{e[:pending]})\" {\n"
      d2 << "  style: { stroke: \"#bb8800\"; font-color: \"#bb8800\"; stroke-dash: 3 }\n}\n"
    else
      d2 << "#{from} -> #{to}: \"#{e[:verb]} #{e[:arity]}\"\n"
    end
  end
end
duals_pairs.each do |a, b|
  d2 << "#{fullpath[a] || a} <-> #{fullpath[b] || b}: dual {\n"
  d2 << "  style: { stroke: \"#666666\"; bold: true }\n}\n"
end
pending_rels.each do |pr|
  d2 << "#{fullpath[pr[:from]] || pr[:from]} -> #{fullpath[pr[:to]] || pr[:to]}: \"is-a? pending (#{pr[:cite]})\" {\n"
  d2 << "  style: { stroke: \"#bb8800\"; font-color: \"#bb8800\"; stroke-dash: 3 }\n}\n"
end

out_dir = terms_dir.join("diagrams")
files = { "euler.dot" => euler, "relations.dot" => rel, "relations.mmd" => mmd,
          "unified.d2" => d2 }
if opts[:check]
  stale = files.reject { |name, c| out_dir.join(name).exist? && out_dir.join(name).read == c }.keys
  abort "terminology-diagrams: stale (#{stale.join(', ')})" unless stale.empty?
  warn "terminology-diagrams: #{terms.size} terms — diagrams current."
  exit 0
end
out_dir.mkpath
files.each do |name, c|
  path = out_dir.join(name)
  next if path.exist? && path.read == c
  path.write(c)
  warn "terminology-diagrams: wrote #{path.relative_path_from(root)}"
end

# Render SVGs beside the .dot sources (steward request 2026-08-08). Graphviz is
# optional tooling: absent `dot` degrades to a note, never a failure — the .dot
# files remain the artifacts of record and render anywhere.
if system("command -v dot >/dev/null 2>&1")
  files.keys.grep(/\.dot\z/).each do |name|
    src = out_dir.join(name)
    svg = out_dir.join(name.sub(/\.dot\z/, ".svg"))
    if system("dot", "-Tsvg", src.to_s, "-o", svg.to_s)
      warn "terminology-diagrams: rendered #{svg.relative_path_from(root)}"
    else
      warn "terminology-diagrams: WARNING — dot failed on #{name} (svg not updated)"
    end
  end
else
  warn "terminology-diagrams: graphviz `dot` not found — .svg render skipped (.dot files current)"
end
if system("command -v d2 >/dev/null 2>&1")
  src = out_dir.join("unified.d2")
  svg = out_dir.join("unified.svg")
  ok = system("d2", "--layout=elk", src.to_s, svg.to_s, err: File::NULL) ||
       system("d2", src.to_s, svg.to_s)
  warn(ok ? "terminology-diagrams: rendered #{svg.relative_path_from(root)}" :
            "terminology-diagrams: WARNING — d2 failed on unified.d2 (svg not updated)")
else
  warn "terminology-diagrams: d2 not found — unified.svg render skipped (unified.d2 current)"
end
warn "terminology-diagrams: #{terms.size} terms, #{children.values.flatten.size} containments, #{pending_rels.size} pending, #{disjoints.size} disjoint pairs."
