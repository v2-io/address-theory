# unified.d2 — GENERATED by bin/terminology-diagrams; do not hand-edit.
# Containment = nesting (never edges); every edge is a relation; edges may
# terminate at container borders. Render: d2 --layout=elk unified.d2 out.svg
# (unified.svg beside this file is rendered by the in-script bespoke engine)
# knobs: layout=bespoke direction=right font=16 container_font=20 edge_font=12 collapse_inverse=true hide_belongs_to=false
direction: right
canonical-location: {
  style.font-size: 16
  tooltip: "The promise 'this will keep resolving' — breaking it is a breach, not an event."
}
descriptor: {
  style.font-size: 20
  tooltip: "One narrowing supplied by a reference-act — connected to its referent by an agreement or by a fact, and nothing else."
  description: {
    style.font-size: 20
    tooltip: "A predicate the world satisfies — nothing was ever bound; the connection is recomputed from whatever satisfies it at each use."
    location: {
      style.font-size: 20
      tooltip: "A containment claim over a designated container — 'contained in c', where c is named by a containment-coordinate."
      intermediate-location: {
        style.font-size: 16
        tooltip: "A non-terminal step of a path that is itself a location."
      }
    }
  }
  designator: {
    style.font-size: 20
    tooltip: "A minted name bound to its referent by convention — the binding, not the referent's properties, is the whole connection."
    containment-coordinate: {
      style.font-size: 16
      tooltip: "The name of one nesting container inside a location chain."
    }
    identity-component: {
      style.font-size: 16
      tooltip: "A designator for the target itself, as opposed to its containers."
    }
  }
}
destination: {
  style.font-size: 16
  tooltip: "The location a path routes to."
}
entity: {
  style.font-size: 16
  tooltip: "A thing whose identity is independent of its current description — it persists through change."
}
epistemic-bound: {
  style.font-size: 16
  tooltip: "How many the actor believes exist — 'no more than three, or I've grossly misunderstood the data.'"
}
expected-cardinality: {
  style.font-size: 16
  tooltip: "How many referents the actor means to pick out — part of the act's type, knowable before resolution, and what gives a miss its meaning."
}
naming-community: {
  style.font-size: 16
  tooltip: "Whoever maintains a designator's binding — a family, a filesystem, a store."
}
operational-bound: {
  style.font-size: 16
  tooltip: "How many the act will touch — 'change the first,' 'take them all.'"
}
origin: {
  style.font-size: 16
  tooltip: "The location a path routes from."
}
over-determination: {
  style.font-size: 16
  tooltip: "Descriptors past the minimum needed to reach one referent — they are verification and redundant routes, never waste."
}
path: {
  style.font-size: 20
  tooltip: "One set of monotonic steps between two locations."
  universal-path: {
    style.font-size: 16
    tooltip: "A path routable to its destination from any origin (within a bounded context)."
  }
  working-path: {
    style.font-size: 16
    tooltip: "No promise at all: whatever route works from here, now — expected to expire with its context."
  }
}
perspective: {
  style.font-size: 16
  tooltip: "What an engine resolves relative to: an origin, a scope, a moment, a policy about what counts as the world."
}
preferred-location: {
  style.font-size: 16
  tooltip: "The promise 'this resolves today, and it's the one we'd rather you use.'"
}
progressive-routing: {
  style.font-size: 16
  tooltip: "Per-hop ownership of resolution: each intermediate location routes only its next hop."
}
reference-act: {
  style.font-size: 16
  tooltip: "'The address you gave us is ambiguous and there are several people by that name it might end up with.' — the refused package that opens the postal model"
}
referent: {
  style.font-size: 16
  tooltip: "The thing a reference-act intends to pick out."
}
resolution-engine: {
  style.font-size: 16
  tooltip: "What performs resolution — never a property of the act itself."
}
sequence-cause: {
  style.font-size: 16
  tooltip: "Why order appears in an address at all — and exactly what an engine may optimize."
}
true-identity: {
  style.font-size: 16
  tooltip: "The promise 'this names IT' — held by the minting community, independent of routability."
}
value-object: {
  style.font-size: 16
  tooltip: "A thing that IS its description — 'which one' is a meaningless question."
}
# collapsed inverse: containment-coordinate -> location (belongs-to {1,1})
# collapsed inverse: designator -> naming-community (held-by {1,1})
# collapsed inverse: destination -> path (belongs-to {1,1})
# collapsed inverse: epistemic-bound -> expected-cardinality (belongs-to {1,1})
# collapsed inverse: expected-cardinality -> reference-act (belongs-to {1,1})
# collapsed inverse: operational-bound -> expected-cardinality (belongs-to {1,1})
# collapsed inverse: origin -> path (belongs-to {1,1})
# collapsed inverse: sequence-cause -> path (belongs-to {1,1})
# collapsed inverse: resolution-engine -> perspective (relative-to {1,1})
# collapsed inverse: referent -> reference-act (targeted-by {1,N})
descriptor.description -> referent: "picks-out {0,N}" { style.font-size: 12 }
destination -> descriptor.description.location: "filled-by {1,1}" { style.font-size: 12 }
entity -> descriptor.designator: "identified-by {1,N}" { style.font-size: 12 }
expected-cardinality -> epistemic-bound: "has {0,1}" { style.font-size: 12 }
expected-cardinality -> operational-bound: "has {1,1}" { style.font-size: 12 }
descriptor.description.location.intermediate-location -> path: "is-a-nonterminal-step-of {1,N}" { style.font-size: 12 }
descriptor.description.location -> descriptor.designator.containment-coordinate: "names-its-container-via {1,N}" { style.font-size: 12 }
naming-community -> descriptor.designator: "maintains {0,N}" { style.font-size: 12 }
origin -> descriptor.description.location: "filled-by {1,1}" { style.font-size: 12 }
over-determination -> referent: "verifies {1,N}" { style.font-size: 12 }
path -> destination: "has {1,1}" { style.font-size: 12 }
path -> origin: "has {1,1}" { style.font-size: 12 }
path -> sequence-cause: "steps-each-carry {1,1}" { style.font-size: 12 }
perspective -> resolution-engine: "parameterizes {1,N}" { style.font-size: 12 }
progressive-routing -> resolution-engine: "performed-by {1,1}" { style.font-size: 12 }
reference-act -> descriptor: "has {1,N}" { style.font-size: 12 }
reference-act -> expected-cardinality: "carries {1,1}" { style.font-size: 12 }
reference-act -> referent: "targets {1,N}" { style.font-size: 12 }
resolution-engine -> reference-act: "resolves {0,N}" { style.font-size: 12 }
descriptor.description <-> descriptor.designator: dual {
  style: { stroke: "#666666"; bold: true; font-size: 12 }
}
destination <-> origin: dual {
  style: { stroke: "#666666"; bold: true; font-size: 12 }
}
entity <-> value-object: dual {
  style: { stroke: "#666666"; bold: true; font-size: 12 }
}
epistemic-bound <-> operational-bound: dual {
  style: { stroke: "#666666"; bold: true; font-size: 12 }
}
canonical-location -> path.universal-path: "is-a? pending (d11-universal-path)" {
  style: { stroke: "#bb8800"; font-color: "#bb8800"; stroke-dash: 3; font-size: 12 }
}
