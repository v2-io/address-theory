// relations.dot — GENERATED by bin/terminology-diagrams; do not hand-edit.
// Typed |rel edges + :dual-of pair-bindings + partition membership.
// Render: dot -Tsvg relations.dot -o relations.svg
digraph relations {
  rankdir=LR; fontname="Helvetica";
  node [fontname="Helvetica", shape=box, style=rounded];
  // omitted (no typed relations; see euler.dot): canonical-location, identity-component, preferred-location, true-identity, universal-location, working-path
  "containment-coordinate" [tooltip="One nesting-container designator inside a location chain."];
  "description" [tooltip="A predicate the world satisfies; picks out whatever currently satisfies it — plurality is a feature."];
  "descriptor" [tooltip="What an act supplies to narrow candidates; comes in exactly two kinds, split by what connects it to the referent."];
  "designator" [tooltip="A minted name bound by convention; fails by dangling or colliding."];
  "entity" [tooltip="A thing whose identity is independent of its current description; persists through change."];
  "epistemic-bound" [tooltip="How many the actor believes exist; divergence is dialogue, not failure — and recorded bounds are free calibration."];
  "expected-cardinality" [tooltip="Part of the act's type: how many referents the actor means to pick out; gives a miss its meaning."];
  "intermediate-location" [tooltip="A step along a path that is itself a location, owning the routing of its next hop."];
  "location" [tooltip="A containment-coordinate descriptor family; powerful because containers can route."];
  "naming-community" [tooltip="Whoever maintains a designator's binding: a family, a filesystem, a registry, a store."];
  "operational-bound" [tooltip="How many the act will touch; divergence is failure."];
  "over-determination" [tooltip="Descriptors past the minimum are verification and redundant routes, not redundancy."];
  "path" [tooltip="One set of monotonic steps between an origin location and a destination location."];
  "perspective" [tooltip="What an engine resolves relative to: an origin, a scope, a moment, a policy about what counts as the world."];
  "progressive-routing" [tooltip="Per-hop ownership of resolution; quietly generates most of the machinery."];
  "reference-act" [tooltip="The root act: descriptors supplied to narrow the world to an intended referent."];
  "referent" [tooltip="The thing an act intends to pick out."];
  "resolution-engine" [tooltip="What performs resolution, relative to a perspective; owes the actor six obligations."];
  "sequence-cause" [tooltip="Why order appears in an address at all: three causes, per-segment, and exactly what an engine may optimize."];
  "value-object" [tooltip="A thing that IS its description; cannot dangle, rename, or change."];
  "containment-coordinate" -> "location" [label="part-of", fontsize=9];
  "description" -> "designator" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "descriptor" -> "reference-act" [label="part-of", fontsize=9];
  "designator" -> "naming-community" [label="held-by (1)", fontsize=9];
  "entity" -> "designator" [label="identified-by", fontsize=9];
  "entity" -> "value-object" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "epistemic-bound" -> "expected-cardinality" [label="part-of", fontsize=9];
  "epistemic-bound" -> "operational-bound" [dir=both, style=bold, label="dual", fontsize=9, color="#666666"];
  "expected-cardinality" -> "reference-act" [label="part-of", fontsize=9];
  "expected-cardinality" -> "operational-bound" [label="has (1)", fontsize=9];
  "expected-cardinality" -> "epistemic-bound" [label="has (?)", fontsize=9];
  "intermediate-location" -> "progressive-routing" [label="performs", fontsize=9];
  "location" -> "containment-coordinate" [label="composed-of (+)", fontsize=9];
  "naming-community" -> "designator" [label="maintains (*)", fontsize=9];
  "operational-bound" -> "expected-cardinality" [label="part-of", fontsize=9];
  "over-determination" -> "referent" [label="verifies", fontsize=9];
  "path" -> "location" [label="from (1)", fontsize=9];
  "path" -> "location" [label="to (1)", fontsize=9];
  "path" -> "sequence-cause" [label="has (+)", fontsize=9];
  "perspective" -> "resolution-engine" [label="parameterizes", fontsize=9];
  "progressive-routing" -> "resolution-engine" [label="performed-by", fontsize=9];
  "reference-act" -> "descriptor" [label="has (+)", fontsize=9];
  "reference-act" -> "referent" [label="targets", fontsize=9];
  "reference-act" -> "expected-cardinality" [label="has (1)", fontsize=9];
  "referent" -> "reference-act" [label="targeted-by", fontsize=9];
  "resolution-engine" -> "reference-act" [label="resolves (*)", fontsize=9];
  "resolution-engine" -> "perspective" [label="relative-to (1)", fontsize=9];
  "sequence-cause" -> "path" [label="property-of", fontsize=9];
}
